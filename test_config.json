{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "udp",
        "server": "1.1.1.1"
      },
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "8.8.8.8"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "SpicyVPN-TUN",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "gvisor",
      "mtu": 1350
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "140.245.13.64",
      "server_port": 8444,
      "uuid": "fake-uuid",
      "packet_encoding": "xudp",
      "domain_resolver": "dns-direct",
      "tls": {
        "enabled": true,
        "server_name": "spicypepper.app",
        "insecure": false,
        "alpn": [
          "h2"
        ]
      },
      "transport": {
        "type": "grpc",
        "service_name": "spicypepper-grpc",
        "idle_timeout": "15s",
        "ping_timeout": "15s"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "140.245.13.64"
        ],
        "outbound": "direct"
      }
    ],
    "final": "proxy"
  }
}
